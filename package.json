{
  "name": "elm-personal-number",
  "description": "A library for validating personal numbers",
  "version": "1.0.0",
  "scripts": {
    "test": "npm-run-all --print-name --silent --sequential test:make test:docs test:run",
    "test:make": "elm make",
    "test:run": "elm-test-rs",
    "test:docs": "elm-verify-examples --run-tests",
    "postinstall": "elm-tooling install"
  },
  "devDependencies": {
    "elm-tooling": "^1.15.1",
    "elm-verify-examples": "^6.0.3",
    "npm-run-all": "^4.1.5"
  }
}
